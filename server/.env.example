PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Built-in simulations run without a database. Jobs expire after six hours and
# are discarded when the server restarts. A Mongo URI alone does not opt in.
SIMULATION_JOB_STORE=memory

# Optional persistent storage: explicitly choose mongo, then configure its URI.
# SIMULATION_JOB_STORE=mongo
# MONGO_URI=mongodb://127.0.0.1:27017
# MONGO_DB_NAME=jaldristi

# Optional separately installed SPH service. No external service is bundled.
# SIMULATION_ENGINE_URL=http://127.0.0.1:8000
